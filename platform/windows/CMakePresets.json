{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/x64",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "x64",
      "inherits": "base",
      "displayName": "x64 (MSVC, Ninja Multi-Config)"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
