<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package manifest for Plain Path Copy, generated by CMake from
  package/AppxManifest.xml.in.

  The package gives the DLL the identity Windows 11 requires before it shows a
  command in the modern File Explorer context menu. It holds no program files:
  AllowExternalContent points it at the folder the app was unzipped to, and
  the settings app registers it with that folder as the external location.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity
    Name="@APP_PACKAGE_NAME@"
    Publisher="@APP_PUBLISHER@"
    Version="@APP_VERSION_QUAD@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@APP_NAME@</DisplayName>
    <PublisherDisplayName>@APP_PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>assets\store-logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="PlainPathCopy" Executable="@APP_EXE@"
      uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="@APP_NAME@"
        Description="Adds Copy as path (/) to the File Explorer context menu."
        BackgroundColor="transparent"
        Square150x150Logo="assets\square-150.png"
        Square44x44Logo="assets\square-44.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="CopyForwardSlashPath" Clsid="@APP_COMMAND_CLSID@" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="CopyForwardSlashPath" Clsid="@APP_COMMAND_CLSID@" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="CopyForwardSlashPath" Clsid="@APP_COMMAND_CLSID@" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="@APP_NAME@ context menu command">
              <com:Class Id="@APP_COMMAND_CLSID@" Path="@APP_SHELL_DLL@"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
