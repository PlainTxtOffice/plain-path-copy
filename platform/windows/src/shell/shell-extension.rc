#include <winres.h>

#include "app-info.h"
#include "shell-resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP_ICON ICON "plain-path-copy.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_COMMAS
 PRODUCTVERSION APP_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", APP_PUBLISHER_DISPLAY_NAME_STRING
      VALUE "FileDescription", APP_NAME_STRING " File Explorer command"
      VALUE "FileVersion", APP_VERSION_STRING
      VALUE "InternalName", "plain-path-copy-shell"
      VALUE "OriginalFilename", "plain-path-copy-shell.dll"
      VALUE "ProductName", APP_NAME_STRING
      VALUE "ProductVersion", APP_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
